#include <stdio.h>
#include <math.h>

int es_primo(int num) {
    if (num <= 1) {
        return 0;
    }
    for (int i = 2; i <= sqrt(num); i++) {
        if (num % i == 0) {
            return 0;
        }
    }
    return 1;
}

int main() {
    int numeros[5];
    int suma = 0, resta, producto = 1;

    printf("Ingrese 5 números positivos:\n");
    for (int i = 0; i < 5; i++) {
        do {
            printf("Número %d: ", i + 1);
            scanf("%d", &numeros[i]);
        } while (numeros[i] <= 0);
        suma += numeros[i];
        producto *= numeros[i];
    }

    resta = numeros[0] - (suma - numeros[0]); // Resta de todos los números al primero

    printf("\nResultados:\n");
    printf("Suma: %d\n", suma);
    printf("Resta: %d\n", resta);
    printf("Producto: %d\n", producto);

    
    if (suma > 10 || resta > 10 || producto > 10) {
        printf("Alguna operación es mayor a 10.\n");
    } else if (suma < 10 && resta < 10 && producto < 10) {
        printf("Todas las operaciones son menores a 10.\n");
    }

    if (es_primo(suma) || es_primo(resta) || es_primo(producto)) {
        printf("Al menos un resultado es un número primo.\n");
    }

    int todos_iguales = 1;
    for (int i = 1; i < 5; i++) {
        if (numeros[i] != numeros[0]) {
            todos_iguales = 0;
            break;
        }
    }
    if (todos_iguales) {
        printf("Todos los números son iguales.\n");
    }

    int todos_multiplos_10 = 1;
    for (int i = 0; i < 5; i++) {
        if (numeros[i] % 10 != 0) {
            todos_multiplos_10 = 0;
            break;
        }
    }
    if (todos_multiplos_10) {
        printf("Todos los números son múltiplos de 10.\n");
    }

    return 0;
}
